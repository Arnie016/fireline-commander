GEMINI_API_KEY=
GEMINI_API_ENDPOINT=

# Elastic Cloud / Elasticsearch index search used by the visible cockpit evidence panel.
ELASTICSEARCH_URL=
ELASTIC_MCP_ENDPOINT=
ELASTIC_API_KEY=
ELASTIC_INDEX=drill_knowledge
ELASTIC_SPACE_NAME=default
NEXT_PUBLIC_ELASTIC_EVIDENCE_MODE=true

# Optional admin-only values for npm run elastic:create-key.
# Do not deploy these to production.
ELASTIC_ADMIN_API_KEY=
ELASTIC_USERNAME=
ELASTIC_PASSWORD=
ELASTIC_API_KEY_NAME=fireline-commander-demo-key
ELASTIC_API_KEY_EXPIRATION=7d
