{
  "mcpServers": {
    "elastic-agent-builder": {
      "command": "npx",
      "args": [
        "mcp-remote",
        "${KIBANA_URL}/api/agent_builder/mcp",
        "--header",
        "Authorization:${AUTH_HEADER}"
      ],
      "env": {
        "KIBANA_URL": "https://YOUR_KIBANA_URL",
        "AUTH_HEADER": "ApiKey ${ELASTIC_API_KEY}"
      }
    }
  }
}
